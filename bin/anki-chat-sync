#!/bin/bash
# anki-chat-sync — add new words from words.txt to Anki.
#   1. DWDS first: dwds-text --anki WORD (skips words already in the deck).
#   2. No DWDS entry: add a card with the word in bold and an empty Back,
#      then anki-update -y lets Claude fill it.
# Words that were handled are remembered in ~/.cache/anki-words-done.
set -u
repo="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
done_file="$HOME/.cache/anki-words-done"
deck="German Vocabulary"
mkdir -p "$(dirname "$done_file")"; touch "$done_file"

anki() { curl -s --max-time 10 http://127.0.0.1:8765 -X POST -d "$1"; }

anki_up() { anki '{"action":"version","version":6}' >/dev/null; }

# If Anki isn't open, start it and close it again at the end (closing syncs to AnkiWeb).
# An Anki window that was already open is left alone.
if ! anki_up; then
    if [[ -z "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
        echo "Anki is not running and there is no graphical session to start it in."; exit 1
    fi
    setsid -f anki >/dev/null 2>&1
    for _ in $(seq 60); do anki_up && break; sleep 1; done
    anki_up || { echo "Started Anki, but AnkiConnect didn't respond within 60 s."; exit 1; }
    sleep 3   # let Anki finish its startup sync
    trap 'anki "{\"action\":\"guiExitAnki\",\"version\":6}" >/dev/null' EXIT
fi

git -C "$repo" pull --quiet origin main || { echo "git pull failed"; exit 1; }

need_fill=0
while IFS= read -r word || [[ -n "$word" ]]; do
    word=$(sed 's/^[[:space:]]*//;s/[[:space:]]*$//' <<< "$word")
    [[ -z "$word" || "$word" == \#* ]] && continue
    grep -qxF -- "$word" "$done_file" && continue

    out=$(dwds-text --anki "$word" 2>&1); rc=$?
    echo "$out"
    if (( rc == 0 )); then
        echo "$word" >> "$done_file"
    elif [[ "$out" == "Kein DWDS-Eintrag"* ]]; then
        note=$(jq -n --arg f "<b>$word</b>" --arg d "$deck" '{action:"addNote",version:6,params:{note:{
            deckName:$d, modelName:"Basic", fields:{Front:$f, Back:""}, tags:["claude-chat"],
            options:{allowDuplicate:false, duplicateScope:"deck"}}}}')
        err=$(anki "$note" | jq -r '.error // empty')
        if [[ -z "$err" ]]; then
            echo "„$word“: no DWDS entry — added for Claude to fill."; need_fill=1
            echo "$word" >> "$done_file"
        elif [[ "$err" == *duplicate* ]]; then
            echo "$word" >> "$done_file"
        else
            echo "„$word“: AnkiConnect error: $err"
        fi
    fi
    # any other failure (DWDS unreachable, Anki closed mid-run): retried next time
done < "$repo/words.txt"

if (( need_fill )); then
    anki-update -y
fi
